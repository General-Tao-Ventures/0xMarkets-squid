# Dependencies
node_modules/

# Build output
lib/
builds/

# Generated files
# NOTE: src/model/generated/ is intentionally COMMITTED — the Docker build runs
# `npm run build` (tsc) only, never `codegen`, so the models must exist in the image.
src/abi/*.ts

