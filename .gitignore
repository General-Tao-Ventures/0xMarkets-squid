.env

# Database (re-include migrations for deployment)
db/*
!db/migrations/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Subsquid
.sqd/
