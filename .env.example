# Database - adjust to match your local Postgres / docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_NAME=squid
DB_USER=squid
DB_PASS=squid

# 8453 = Base mainnet (default), 84532 = Base Sepolia (future testnet)
CHAIN_ID=8453

# RPC endpoint for the active chain
RPC_URL=https://mainnet.base.org

# Required for v2 archive gateway when self-hosting (since 2026-05-19).
# Create at https://portal.sqd.dev/app — if unset, processor uses RPC only.
SQD_API_KEY=

# GraphQL (squid-graphql-server)
GQL_PORT=4350
